<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Colors need to be converted to a `SolidColorBrush` for properties like `Background`. -->
	<SolidColorBrush x:Key="BackgroundColor" Color="#121212" />
	<SolidColorBrush x:Key="CardBackgroundColor" Color="#2D2D2D" />
	<SolidColorBrush x:Key="PrimaryTextColor" Color="#E1E1E1" />
	<SolidColorBrush x:Key="SecondaryTextColor" Color="#A0A0A0" />
</ResourceDictionary>