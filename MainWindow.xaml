<Window x:Class="VideoLibrarySystemVlc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:VideoLibrarySystemVlc.Converters"
        Title="Video Library System VLC"
        Width="1400"
        Height="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BackgroundColor}"> 
    <Window.Resources>
        <conv:PathLeafConverter x:Key="PathLeafConverter" />
        <conv:ImagePathConverter x:Key="ImagePathConverter" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
        </Style>

        <Style x:Key="TileButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <Style x:Key="RootButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Padding" Value="10,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Video Library System VLC" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" />
			<Button Content="Toggle Dark Mode" DockPanel.Dock="Right" Click="ToggleDarkMode_Click" Margin="20,0,0,0" />
			<TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{DynamicResource SecondaryTextColor}" />
        </DockPanel>

		<TabControl Grid.Row="1" x:Name="MediaTabs" Background="{DynamicResource BackgroundColor}" Foreground="{DynamicResource PrimaryTextColor}">
	



			<TabItem Header="Series" Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource PrimaryTextColor}" >
            
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Series roots" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding SeriesRootOptions}" SelectedItem="{Binding SelectedSeriesRoot}" Height="430">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextColor}" />
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Add Root" Style="{StaticResource RootButtonStyle}" Click="AddSeriesRoot_Click" />
                            <Button Content="Remove Root" Style="{StaticResource RootButtonStyle}" Click="RemoveSeriesRoot_Click" />
                            <Button Content="Scan" Style="{StaticResource RootButtonStyle}" Click="ScanSeries_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox ItemsSource="{Binding SeriesVisibleItems}" SelectedItem="{Binding SelectedSeriesItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Single"
                                 Background="{DynamicResource BackgroundColor}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,12,12" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Height="320" CornerRadius="12" BorderBrush="#DDD" BorderThickness="1" Background="{DynamicResource CardBackgroundColor}" Padding="10">
                                        <StackPanel>
                                            <Border Height="140" CornerRadius="8" Background="{DynamicResource CardBackgroundColor}" ClipToBounds="True">
                                                <Image Source="{Binding ArtworkPath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Margin="0,10,0,0" BorderThickness="0" Background="{DynamicResource CardBackgroundColor}" Height="44" TextWrapping="Wrap" MaxLines="2" VerticalContentAlignment="Top" Foreground="{DynamicResource PrimaryTextColor}" />
                                            <TextBlock Text="{Binding ContainerPath, Converter={StaticResource PathLeafConverter}}" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" Height="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContainerPath}" />
                                            <TextBlock Text="{Binding EpisodeCount, StringFormat=Episodes: {0}}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource SecondaryTextColor}" />
                                            <Grid Margin="0,8,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="Play Playlist"
                                                        Padding="10,4"
                                                        IsEnabled="{Binding CanStartPlayback}"
                                                        Click="PlaySeriesPlaylist_Click" />
                                                <Button Grid.Column="1"
                                                        Content="▶"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        FontWeight="SemiBold"
                                                        ToolTip="Resume from next episode"
                                                        IsEnabled="{Binding CanStartPlayback}"
                                                        Click="ResumeSeriesPlaylist_Click" />
                                                <Button Grid.Column="2"
                                                        Content="⏱"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        FontWeight="SemiBold"
                                                        FontSize="16"
                                                        ToolTip="Resume same video from where you left off"
                                                        IsEnabled="{Binding CanStartPlayback}"
                                                        Click="ResumeSameVideo_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundColor}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedSeriesItem.Title}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" />
                                    <TextBlock Text="{Binding SelectedSeriesItem.ContainerPath}" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" />
                                    <ListBox x:Name="SeriesEpisodeList"
                                             ItemsSource="{Binding SelectedSeriesEpisodeEntries}"
                                              Height="170"
                                              Margin="0,10,0,0"
                                              MouseDoubleClick="SeriesEpisodeList_MouseDoubleClick">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel>
                                                    <StackPanel DockPanel.Dock="Left"
                                                                Orientation="Horizontal"
                                                                Visibility="{Binding MarkerVisibility}"
                                                                Margin="0,0,8,0">
                                                        <TextBlock Text="▶"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   Opacity="{Binding MarkerOpacity}"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding MarkerRank}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource AccentColor}"
                                                                   Margin="3,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding FilePath, Converter={StaticResource PathLeafConverter}}"
                                                               VerticalAlignment="Center" />
                                                </DockPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Grid Margin="0,0,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="34" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0"
                                                Content="Play Playlist"
                                                Padding="10,4"
                                                IsEnabled="{Binding CanStartPlayback}"
                                                Click="PlaySelectedSeriesPlaylist_Click" />
                                        <Button Grid.Column="1"
                                                Content="▶"
                                                Margin="6,0,0,0"
                                                Padding="0"
                                                FontWeight="SemiBold"
                                                ToolTip="Resume from next episode"
                                                IsEnabled="{Binding CanStartPlayback}"
                                                Click="ResumeSelectedSeriesPlaylist_Click" />
                                    </Grid>
                                    <Button Content="Play Selected Episode" Style="{StaticResource RootButtonStyle}" IsEnabled="{Binding CanStartPlayback}" Click="PlaySelectedSeriesEpisode_Click" />
                                    <Button Content="Set Artwork" Style="{StaticResource RootButtonStyle}" Click="SetSelectedSeriesArtwork_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

			<TabItem Header="Movies" Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource PrimaryTextColor}">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Movie roots" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox ItemsSource="{Binding MovieRootOptions}" SelectedItem="{Binding SelectedMovieRoot}" Height="430">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource PrimaryTextColor}" />
                                        <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Add Root" Style="{StaticResource RootButtonStyle}" Click="AddMovieRoot_Click" />
                            <Button Content="Remove Root" Style="{StaticResource RootButtonStyle}" Click="RemoveMovieRoot_Click" />
                            <Button Content="Scan" Style="{StaticResource RootButtonStyle}" Click="ScanMovies_Click" />
                        </WrapPanel>
                    </StackPanel>

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListBox ItemsSource="{Binding MovieVisibleItems}" SelectedItem="{Binding SelectedMovieItem}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionMode="Single"
                                 Background="{DynamicResource BackgroundColor}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel IsItemsHost="True" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,12,12" />
                                    <Setter Property="Padding" Value="0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Height="320" CornerRadius="12" BorderBrush="#DDD" BorderThickness="1" Background="{DynamicResource CardBackgroundColor}" Padding="10">
                                        <StackPanel>
                                            <Border Height="140" CornerRadius="8" Background="{DynamicResource CardBackgroundColor}" ClipToBounds="True">
                                                <Image Source="{Binding ArtworkPath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" Margin="0,10,0,0" BorderThickness="0" Background="{DynamicResource CardBackgroundColor}" Height="44" TextWrapping="Wrap" MaxLines="2" VerticalContentAlignment="Top" Foreground="{DynamicResource PrimaryTextColor}" />
                                            <TextBlock Text="{Binding ContainerPath, Converter={StaticResource PathLeafConverter}}" FontSize="11" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" Height="34" TextTrimming="CharacterEllipsis" ToolTip="{Binding ContainerPath}" />
                                            <Button Content="Play" Style="{StaticResource TileButtonStyle}" IsEnabled="{Binding DataContext.CanStartPlayback, RelativeSource={RelativeSource AncestorType=Window}}" Click="PlayMovie_Click" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="1" Margin="0,12,0,0" Padding="12" BorderBrush="#DDD" BorderThickness="1" CornerRadius="8" Background="{DynamicResource CardBackgroundColor}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="260" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedMovieItem.Title}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding SelectedMovieItem.ContainerPath}" Foreground="{DynamicResource ForegroundColor}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Button Content="Play Movie" Style="{StaticResource RootButtonStyle}" IsEnabled="{Binding CanStartPlayback}" Click="PlaySelectedMovie_Click" />
                                    <Button Content="Set Artwork" Style="{StaticResource RootButtonStyle}" Click="SetSelectedMovieArtwork_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

			<TabItem Header="Settings" Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource PrimaryTextColor}"  >
				<Grid Margin="24">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<TextBlock Text="VLC executable" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" />
					<TextBlock Grid.Row="1" Margin="0,8,0,12" Text="The app will try to detect VLC automatically. If it fails, browse to vlc.exe here." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextColor}" />

					<WrapPanel Grid.Row="2">
						<TextBox Text="{Binding VlcExecutablePath, UpdateSourceTrigger=PropertyChanged}" MinWidth="720" Margin="0,0,12,0" Foreground="{DynamicResource PrimaryTextColor}" Background="{DynamicResource CardBackgroundColor}" />
						<StackPanel Orientation="Horizontal" Margin="0,8,0,0">
							<Button Content="Browse..." Margin="0,0,8,0" Padding="10,4" Click="BrowseVlcPath_Click" />
							<Button Content="Detect" Margin="0,0,8,0" Padding="10,4" Click="DetectVlcPath_Click" />
							<Button Content="Save" Padding="10,4" Click="SaveVlcPath_Click" />
						</StackPanel>
					</WrapPanel>

					<TextBlock Grid.Row="3" Margin="0,16,0,0" Text="{Binding VlcPathStatus}" Foreground="{DynamicResource SecondaryTextColor}" TextWrapping="Wrap" />

					<!-- Back Rooms Settings -->
					<StackPanel Grid.Row="3" Margin="0,32,0,0">
						<TextBlock Text="Back Rooms Settings" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,12" />

						<!-- Ticker Tape Toggle -->
						<CheckBox Content="Enable Ticker Tape" 
								  IsChecked="{Binding TickerTapeVisible}" 
								  Margin="0,0,0,16"
								  Foreground="{DynamicResource PrimaryTextColor}"
								  Click="TickerTapeToggle_Click" />

						<!-- Collectibles Source URL -->
						<TextBlock Text="Collectibles Source URL (or file path)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4" />
						<TextBlock Text="Use 'file://' prefix for local files, or http/https for remote sources." 
								   FontSize="11" 
								   Foreground="{DynamicResource SecondaryTextColor}" 
								   TextWrapping="Wrap" 
								   Margin="0,0,0,8" />
						<TextBox x:Name="CollectiblesSourceUrlTextBox"
								 Text="{Binding CollectiblesSourceUrl, UpdateSourceTrigger=PropertyChanged}" 
								 MinWidth="720" 
								 Margin="0,0,0,4"
								 Foreground="{DynamicResource PrimaryTextColor}" 
								 Background="{DynamicResource CardBackgroundColor}" />
						<Button Content="Save Collectibles URL" 
								Margin="0,4,0,16" 
								Padding="10,4" 
								Click="SaveCollectiblesUrl_Click" />

						<!-- Ticker Reviews URL -->
						<TextBlock Text="Ticker Tape Reviews URL (or file path)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4" />
						<TextBlock Text="Reviews will scroll across the bottom of the window." 
								   FontSize="11" 
								   Foreground="{DynamicResource SecondaryTextColor}" 
								   Margin="0,0,0,8" />
						<TextBox x:Name="TickerReviewsUrlTextBox"
								 Text="{Binding TickerReviewsUrl, UpdateSourceTrigger=PropertyChanged}" 
								 MinWidth="720" 
								 Margin="0,0,0,4"
								 Foreground="{DynamicResource PrimaryTextColor}" 
								 Background="{DynamicResource CardBackgroundColor}" />
						<Button Content="Save Ticker Reviews URL" 
								Margin="0,4,0,16" 
								Padding="10,4" 
								Click="SaveTickerReviewsUrl_Click" />

						<!-- Late Fee URL -->
						<TextBlock Text="Late Fee Payment URL" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" Margin="0,0,0,4" />
						<TextBlock Text="Where users go when they click 'Pay Your Late Fee'." 
								   FontSize="11" 
								   Foreground="{DynamicResource SecondaryTextColor}" 
								   Margin="0,0,0,8" />
						<TextBox x:Name="LateFeeUrlTextBox"
								 Text="{Binding LateFeeUrl, UpdateSourceTrigger=PropertyChanged}" 
								 MinWidth="720" 
								 Margin="0,0,0,4"
								 Foreground="{DynamicResource PrimaryTextColor}" 
								 Background="{DynamicResource CardBackgroundColor}" />
						<Button Content="Save Late Fee URL" 
								Margin="0,4,0,0" 
								Padding="10,4" 
								Click="SaveLateFeeUrl_Click" />
					</StackPanel>
				</Grid>
			</TabItem>

			<TabItem Header="Back Rooms" Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource PrimaryTextColor}">
				<Grid Margin="8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="270" />
						<ColumnDefinition Width="16" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>

					<!-- Left Panel: Navigation & Controls -->
					<StackPanel Grid.Column="0">
						<!-- Gem Counter -->
						<TextBlock Text="Gems" FontWeight="SemiBold" Margin="0,0,0,4" Foreground="{DynamicResource PrimaryTextColor}" />
						<TextBox x:Name="GemCountTextBox" 
								 Text="{Binding BackRoomsGems, UpdateSourceTrigger=PropertyChanged}" 
								 FontSize="32" 
								 FontWeight="Bold" 
								 TextAlignment="Center"
								 Margin="0,0,0,8"
								 Background="Transparent"
								 BorderThickness="0"
								 Foreground="{DynamicResource PrimaryTextColor}"
								 Cursor="IBeam"
								 LostFocus="GemCountTextBox_LostFocus">
							<TextBox.Style>
								<Style TargetType="TextBox">
									<Setter Property="Template">
										<Setter.Value>
											<ControlTemplate TargetType="TextBox">
												<Border Background="{TemplateBinding Background}" 
														BorderThickness="0">
													<ScrollViewer x:Name="PART_ContentHost" 
																  Margin="0"
																  Focusable="False"
																  HorizontalScrollBarVisibility="Hidden"
																  VerticalScrollBarVisibility="Hidden"/>
												</Border>
											</ControlTemplate>
										</Setter.Value>
									</Setter>
									<!-- Show subtle hint on hover -->
									<Style.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter Property="Background" Value="{DynamicResource CardBackgroundColor}" />
											<Setter Property="Opacity" Value="0.9" />
										</Trigger>
									</Style.Triggers>
								</Style>
							</TextBox.Style>
						</TextBox>

						<TextBlock x:Name="NextGemTimerText" 
								   Text="Next gem in: --:--:--" 
								   FontSize="11" 
								   Foreground="{DynamicResource SecondaryTextColor}" 
								   TextAlignment="Center"
								   Margin="0,0,0,16" />

						<!-- Loot Crate Button -->
						<Button Content="Open Loot Crate" 
								Style="{StaticResource RootButtonStyle}" 
								FontSize="14"
								Height="40"
								Click="OpenLootCrate_Click" 
								Margin="0,0,0,8" />

						<!-- Reload Data Button (for testing) -->
						<Button Content="🔄 Reload Data" 
								Style="{StaticResource RootButtonStyle}" 
								FontSize="12"
								Click="ReloadBackRoomsData_Click" 
								Margin="0,0,0,16"
								ToolTip="Reload collectibles and reviews from URLs" />

						<!-- Section Navigation -->
						<TextBlock Text="Sections" FontWeight="SemiBold" Margin="0,8,0,8" Foreground="{DynamicResource PrimaryTextColor}" />
						<ListBox x:Name="BackRoomsSectionList" 
								 SelectedIndex="0"
								 Height="200"
								 SelectionChanged="BackRoomsSectionList_SelectionChanged">
							<ListBoxItem Content="Collectibles" />
							<ListBoxItem Content="Loot Crate Info" />
						</ListBox>

						<!-- Pay Late Fee Button -->
						<Button Content="Pay Your Late Fee" 
								Style="{StaticResource RootButtonStyle}" 
								FontSize="13"
								Margin="0,16,0,8"
								Click="PayLateFee_Click" />
					</StackPanel>

					<!-- Right Panel: Content Area -->
					<Grid Grid.Column="2">
						<Grid.RowDefinitions>
							<RowDefinition Height="*" />
							<RowDefinition Height="Auto" />
						</Grid.RowDefinitions>

						<!-- Collectibles Section -->
						<Grid x:Name="CollectiblesSection" Visibility="Visible">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto" />
								<RowDefinition Height="*" />
								<RowDefinition Height="Auto" />
							</Grid.RowDefinitions>

							<TextBlock Text="Your Collectibles" 
									   FontSize="20" 
									   FontWeight="SemiBold" 
									   Margin="0,0,0,12"
									   Foreground="{DynamicResource PrimaryTextColor}" />

							<ListBox Grid.Row="1"
									ItemsSource="{Binding BackRoomsCollectibleGroups}" 
									SelectedItem="{Binding SelectedCollectibleGroup}"
									ScrollViewer.HorizontalScrollBarVisibility="Disabled"
									SelectionMode="Single"
									Background="{DynamicResource BackgroundColor}">
								<ListBox.ItemsPanel>
									<ItemsPanelTemplate>
										<WrapPanel IsItemsHost="True" />
									</ItemsPanelTemplate>
								</ListBox.ItemsPanel>
								<ListBox.ItemContainerStyle>
									<Style TargetType="ListBoxItem">
										<Setter Property="Margin" Value="0,0,12,12" />
										<Setter Property="Padding" Value="0" />
									</Style>
								</ListBox.ItemContainerStyle>
								<ListBox.ItemTemplate>
									<DataTemplate>
										<Border Width="250" Height="380" CornerRadius="12" BorderBrush="#DDD" BorderThickness="1" Background="{DynamicResource CardBackgroundColor}" Padding="10">
											<StackPanel>
												<Border Height="280" CornerRadius="8" Background="{DynamicResource CardBackgroundColor}" ClipToBounds="True">
													<Image Source="{Binding LocalImagePath, Converter={StaticResource ImagePathConverter}}" Stretch="UniformToFill" />
												</Border>
												<TextBlock Text="{Binding Name}" 
														   FontWeight="SemiBold" 
														   Margin="0,10,0,0" 
														   FontSize="14"
														   TextWrapping="Wrap" 
														   Height="36"
														   TextTrimming="CharacterEllipsis"
														   Foreground="{DynamicResource PrimaryTextColor}" />
												<TextBlock Text="{Binding Rarity}" 
														   FontSize="11" 
														   Foreground="{DynamicResource AccentColor}"
														   Margin="0,4,0,0" />
												<!-- Show only the first (most recent) found date on the card -->
												<TextBlock Text="{Binding PrimaryFoundDate, StringFormat='Found: {0:yyyy-MM-dd}'}" 
														   FontSize="10" 
														   Foreground="{DynamicResource SecondaryTextColor}"
														   Margin="0,6,0,0" />
											</StackPanel>
										</Border>
									</DataTemplate>
								</ListBox.ItemTemplate>
							</ListBox>

							<!-- Collectible Detail Panel -->
							<Border Grid.Row="2" 
									Margin="0,12,0,0" 
									Padding="12" 
									BorderBrush="#DDD" 
									BorderThickness="1" 
									CornerRadius="8" 
									Background="{DynamicResource CardBackgroundColor}"
									Visibility="{Binding SelectedCollectibleGroup, Converter={StaticResource NullToVisibilityConverter}}">
								<Grid>
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="180" />
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="*" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<!-- Top: Title and Rarity -->
									<StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,200,0">
										<TextBlock Text="{Binding SelectedCollectibleGroup.Name}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextColor}" />
										<TextBlock Text="{Binding SelectedCollectibleGroup.Rarity, StringFormat='Rarity: {0}'}" 
												   FontSize="13" 
												   Foreground="{DynamicResource AccentColor}" 
												   Margin="0,4,0,8" />
									</StackPanel>

									<!-- Middle-Left: Description and Found Dates (scrollable) -->
									<StackPanel Grid.Row="1" Grid.Column="0">
										<TextBlock Text="{Binding SelectedCollectibleGroup.Description}" 
												   TextWrapping="Wrap" 
												   Foreground="{DynamicResource PrimaryTextColor}"
												   Margin="0,0,0,12" />

										<!-- Scrollable Found Dates -->
										<TextBlock Text="Found Dates:" 
												   FontSize="11" 
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource PrimaryTextColor}"
												   Margin="0,0,0,6" />
										<ScrollViewer Height="80" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
											<ItemsControl ItemsSource="{Binding SelectedCollectibleGroup.FoundDates}">
												<ItemsControl.ItemTemplate>
													<DataTemplate>
														<TextBlock Text="{Binding StringFormat='• {0:yyyy-MM-dd HH:mm:ss} UTC'}" 
																   FontSize="10" 
																   Foreground="{DynamicResource SecondaryTextColor}"
																   Margin="0,2,0,0" />
													</DataTemplate>
												</ItemsControl.ItemTemplate>
											</ItemsControl>
										</ScrollViewer>
									</StackPanel>

									<!-- Right: Image Thumbnail -->
									<Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" 
											Width="180" 
											Height="180" 
											CornerRadius="8" 
											ClipToBounds="True"
											HorizontalAlignment="Right"
											VerticalAlignment="Top">
										<Image Source="{Binding SelectedCollectibleGroup.LocalImagePath, Converter={StaticResource ImagePathConverter}}" 
											   Stretch="UniformToFill" />
									</Border>

									<!-- Bottom: View Full Image Button -->
									<Border Grid.Row="2" Grid.Column="0" CornerRadius="8" Background="{DynamicResource AccentColor}" Margin="0,12,12,0">
										<Button Content="View Full Image" 
												Click="ViewFullImage_Click"
												Padding="12,8"
												Background="Transparent"
												Foreground="White"
												FontSize="12"
												FontWeight="SemiBold"
												BorderThickness="0" />
									</Border>
								</Grid>
							</Border>
							</Grid>

							<!-- Loot Crate Info Section -->
						<Grid x:Name="LootCrateInfoSection" Visibility="Collapsed">
							<StackPanel>
								<TextBlock Text="How Loot Crates Work" 
										   FontSize="20" 
										   FontWeight="SemiBold" 
										   Margin="0,0,0,12"
										   Foreground="{DynamicResource PrimaryTextColor}" />
								<TextBlock TextWrapping="Wrap" 
										   Foreground="{DynamicResource PrimaryTextColor}"
										   Margin="0,0,0,12">
									<Run Text="Welcome to the Back Rooms - your video rental desk reward system!" />
									<LineBreak /><LineBreak />
									<Run Text="• Earn 1 gem every 24 hours" FontWeight="SemiBold" />
									<LineBreak />
									<Run Text="• Open loot crates for 1 gem each" FontWeight="SemiBold" />
									<LineBreak />
									<Run Text="• Collect rare items from your favorite shows and movies" FontWeight="SemiBold" />
									<LineBreak /><LineBreak />
									<Run Text="Or... if you're feeling cheeky, just type in the gem counter above! We know you will. 😄" FontStyle="Italic" />
								</TextBlock>

								<TextBlock Text="Available Collectibles" 
										   FontSize="16" 
										   FontWeight="SemiBold" 
										   Margin="0,16,0,8"
										   Foreground="{DynamicResource PrimaryTextColor}" />
								<TextBlock x:Name="AvailableCollectiblesText"
										   Text="Loading collectibles..." 
										   TextWrapping="Wrap" 
										   Foreground="{DynamicResource SecondaryTextColor}" />
							</StackPanel>
						</Grid>
					</Grid>
				</Grid>
			</TabItem>
		</TabControl>

		<!-- Ticker Tape -->
		<Border Grid.Row="2" 
				Height="30" 
				Background="{DynamicResource CardBackgroundColor}" 
				BorderBrush="#DDD" 
				BorderThickness="0,1,0,1"
				Margin="0,8,0,0"
				ClipToBounds="True"
				Visibility="{Binding TickerTapeVisible, Converter={StaticResource BoolToVisibilityConverter}}">
			<Canvas x:Name="TickerCanvas" Height="30">
				<TextBlock x:Name="TickerTextBlock"
						   Canvas.Top="5"
						   FontSize="14"
						   Foreground="{DynamicResource PrimaryTextColor}"
						   Text="{Binding TickerTapeText}">
					<TextBlock.RenderTransform>
						<TranslateTransform x:Name="TickerTransform" />
					</TextBlock.RenderTransform>
					<TextBlock.Resources>
						<Storyboard x:Key="TickerAnimation" RepeatBehavior="Forever">
							<DoubleAnimation Storyboard.TargetName="TickerTransform"
											 Storyboard.TargetProperty="X"
											 Duration="0:0:30" />
						</Storyboard>
					</TextBlock.Resources>
				</TextBlock>
			</Canvas>
		</Border>

		<StatusBar Grid.Row="3" Margin="0,12,0,0" Background="{DynamicResource CardBackgroundColor}" Foreground="{DynamicResource PrimaryTextColor}">
            <StatusBarItem Content="{Binding StatusText}" />
        </StatusBar>
    </Grid>
</Window>
